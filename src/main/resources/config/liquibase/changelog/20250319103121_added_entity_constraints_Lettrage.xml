<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.9.xsd">
    <!--
        Added the constraints for entity Lettrage.
    -->
    <changeSet id="20250319103121-2" author="jhipster">
        
        <addForeignKeyConstraint baseColumnNames="facture_id"
                                 baseTableName="lettrage"
                                 constraintName="fk_lettrage_facture_id"
                                 referencedColumnNames="id"
                                 referencedTableName="facture"/>

        <addForeignKeyConstraint baseColumnNames="paiement_id"
                                 baseTableName="lettrage"
                                 constraintName="fk_lettrage_paiement_id"
                                 referencedColumnNames="id"
                                 referencedTableName="paiement"/>

    </changeSet>
</databaseChangeLog>
