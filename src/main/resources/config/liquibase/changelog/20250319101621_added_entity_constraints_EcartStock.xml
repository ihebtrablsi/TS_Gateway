<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.9.xsd">
    <!--
        Added the constraints for entity EcartStock.
    -->
    <changeSet id="20250319101621-2" author="jhipster">
        
        <addForeignKeyConstraint baseColumnNames="produit_id"
                                 baseTableName="ecart_stock"
                                 constraintName="fk_ecart_stock_produit_id"
                                 referencedColumnNames="id"
                                 referencedTableName="produit"/>

        <addForeignKeyConstraint baseColumnNames="audit_id"
                                 baseTableName="ecart_stock"
                                 constraintName="fk_ecart_stock_audit_id"
                                 referencedColumnNames="id"
                                 referencedTableName="audit_stock"/>

    </changeSet>
</databaseChangeLog>
